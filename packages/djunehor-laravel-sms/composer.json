            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "Djunehor\\Sms\\SmsServiceProvider"
            ]
        }
    },
    "require": {
        "php": ">=7.1",
        "guzzlehttp/guzzle": ">=6.5",
        "illuminate/support": ">=5.0"
    }
}
