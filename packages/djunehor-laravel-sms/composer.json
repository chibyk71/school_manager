{
    "name": "djunehor/laravel-sms",
    "description": "Local path replacement — upstream GitHub repo is unavailable (404).",
    "version": "2.2.0",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Djunehor\\Sms\\": "src/"
        },
