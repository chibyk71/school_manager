diff --git a/app/Services/FileManager/AttachmentService.php b/app/Services/FileManager/AttachmentService.php
new file mode 100644
index 0000000..1e4f845
--- /dev/null
+++ b/app/Services/FileManager/AttachmentService.php
@@ -0,0 +1,108 @@
+<?php
+
+namespace App\Services\FileManager;
+
+use App\Models\FileManager\Attachment;
+use App\Models\FileManager\File;
+use App\Support\FileManager\AttachableOwnerRegistry;
+use Illuminate\Database\Eloquent\Model;
+use Illuminate\Support\Collection;
+use InvalidArgumentException;
+
+/**
+ * Explicit File ↔ business-owner links with dual authorization and allow-listed owners.
+ */
+final class AttachmentService
+{
+    public function __construct(
+        private readonly FileService $files,
+    ) {}
+
+    /**
+     * @return Collection<int, Attachment>
+     */
+    public function listForFile(File $file, ?string $actingSchoolId): Collection
+    {
+        $resolved = $this->files->findForContext($file->id, $actingSchoolId);
+        if ($resolved === null) {
+            throw new InvalidArgumentException('File is not accessible in the current context.');
+        }
+
+        return Attachment::query()->where('file_id', $file->id)->orderBy('created_at')->get();
+    }
+
+    /**
+     * @param  array{owner_type: string, owner_id: string, purpose?: string, lifecycle?: string}  $data
+     */
+    public function attach(File $file, array $data, ?string $actingSchoolId, ?callable $authorizeOwner = null): Attachment
+    {
+        $resolved = $this->files->findForContext($file->id, $actingSchoolId);
+        if ($resolved === null) {
+            throw new InvalidArgumentException('File is not accessible in the current context.');
+        }
+
+        $ownerClass = AttachableOwnerRegistry::resolve((string) $data['owner_type']);
+        $ownerId = (string) $data['owner_id'];
+
+        /** @var Model|null $owner */
+        $owner = $ownerClass::query()->find($ownerId);
+        if ($owner === null) {
+            throw new InvalidArgumentException('Attachment owner not found.');
+        }
+
+        $this->assertOwnerSchoolBoundary($file, $owner, $actingSchoolId);
+
+        if ($authorizeOwner !== null) {
+            $authorizeOwner($owner);
+        }
+
+        $attachment = new Attachment([
+            'file_id' => $file->id,
+            'owner_type' => $ownerClass,
+            'owner_id' => $ownerId,
+            'purpose' => (string) ($data['purpose'] ?? 'default'),
+            'lifecycle' => (string) ($data['lifecycle'] ?? 'module'),
+        ]);
+        $attachment->save();
+
+        return $attachment->fresh();
+    }
+
+    public function detach(Attachment $attachment, ?string $actingSchoolId): void
+    {
+        $file = $attachment->file;
+        if ($file === null) {
+            $attachment->delete();
+
+            return;
+        }
+
+        $resolved = $this->files->findForContext($file->id, $actingSchoolId);
+        if ($resolved === null) {
+            throw new InvalidArgumentException('File is not accessible in the current context.');
+        }
+
+        // Detach does not delete the physical object or the File row.
+        $attachment->delete();
+    }
+
+    private function assertOwnerSchoolBoundary(File $file, Model $owner, ?string $actingSchoolId): void
+    {
+        // If the owner has a school_id attribute, it must match school-owned files.
+        if ($file->isSchoolOwned() && isset($owner->school_id) && $owner->school_id !== null) {
+            if ((string) $owner->school_id !== (string) $file->school_id) {
+                throw new InvalidArgumentException(
+                    'Cannot attach a file to an owner that belongs to a different school.'
+                );
+            }
+        }
+
+        if ($actingSchoolId !== null && isset($owner->school_id) && $owner->school_id !== null) {
+            if ((string) $owner->school_id !== (string) $actingSchoolId) {
+                throw new InvalidArgumentException(
+                    'Cannot attach to an owner outside the current school context.'
+                );
+            }
+        }
+    }
+}
diff --git a/app/Services/FileManager/FileObjectStorage.php b/app/Services/FileManager/FileObjectStorage.php
new file mode 100644
index 0000000..0fc45b6
--- /dev/null
+++ b/app/Services/FileManager/FileObjectStorage.php
@@ -0,0 +1,218 @@
+<?php
+
+namespace App\Services\FileManager;
+
+use App\Enums\StorageProviderDriver;
+use App\Models\StorageProvider;
+use App\Services\Storage\StorageProviderConnectionTester;
+use Illuminate\Contracts\Filesystem\Filesystem;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Facades\Log;
+use Illuminate\Support\Facades\Storage;
+use Illuminate\Support\Str;
+use RuntimeException;
+use Throwable;
+
+/**
+ * Thin integration between File Manager identities and Phase 1 storage providers.
+ *
+ * Does not reimplement provider CRUD or credential resolution.
+ * No silent fallback to another provider.
+ */
+final class FileObjectStorage
+{
+    public function __construct(
+        private readonly StorageProviderConnectionTester $connectionTester,
+    ) {}
+
+    /**
+     * Generate an opaque storage key independent of display names and folder paths.
+     */
+    public function generateStorageKey(?string $extension = null): string
+    {
+        $key = 'fm/'.Str::uuid()->toString();
+        if ($extension !== null && $extension !== '') {
+            $ext = strtolower(ltrim($extension, '.'));
+            if (preg_match('/^[a-z0-9]{1,16}$/', $ext)) {
+                $key .= '.'.$ext;
+            }
+        }
+
+        return $key;
+    }
+
+    /**
+     * Build a Laravel filesystem disk for the given provider.
+     *
+     * @throws RuntimeException when the provider is disabled or configuration is unsafe
+     */
+    public function diskFor(StorageProvider $provider): Filesystem
+    {
+        if (! $provider->enabled) {
+            throw new RuntimeException('Storage provider is disabled.');
+        }
+
+        $driver = $provider->driver instanceof StorageProviderDriver
+            ? $provider->driver
+            : StorageProviderDriver::from((string) $provider->driver);
+
+        $config = $provider->connectionConfig();
+
+        return match ($driver) {
+            StorageProviderDriver::Local => $this->buildLocalDisk($config),
+            StorageProviderDriver::S3 => $this->buildS3Disk($config),
+        };
+    }
+
+    /**
+     * Write uploaded content to the provider under the given storage key.
+     *
+     * @return array{size_bytes: int, mime_type: string|null, checksum: string|null}
+     *
+     * @throws RuntimeException on write failure
+     */
+    public function write(StorageProvider $provider, string $storageKey, UploadedFile $upload): array
+    {
+        $disk = $this->diskFor($provider);
+
+        try {
+            $stream = fopen($upload->getRealPath(), 'r');
+            if ($stream === false) {
+                throw new RuntimeException('Unable to open uploaded file for reading.');
+            }
+            try {
+                $written = $disk->writeStream($storageKey, $stream);
+            } finally {
+                if (is_resource($stream)) {
+                    fclose($stream);
+                }
+            }
+
+            if ($written === false) {
+                throw new RuntimeException('Storage provider rejected the write operation.');
+            }
+        } catch (Throwable $e) {
+            if ($e instanceof RuntimeException) {
+                throw $e;
+            }
+            throw new RuntimeException('Physical write to storage provider failed.', 0, $e);
+        }
+
+        $mime = $upload->getMimeType() ?: $upload->getClientMimeType();
+        $size = $upload->getSize() ?: 0;
+        $checksum = null;
+        try {
+            $path = $upload->getRealPath();
+            if (is_string($path) && is_file($path)) {
+                $checksum = hash_file('sha256', $path) ?: null;
+            }
+        } catch (Throwable) {
+            $checksum = null;
+        }
+
+        return [
+            'size_bytes' => (int) $size,
+            'mime_type' => is_string($mime) ? $mime : null,
+            'checksum' => $checksum,
+        ];
+    }
+
+    /**
+     * Attempt compensating deletion after a successful physical write when DB persistence fails.
+     *
+     * @return bool true when the object was removed (or already absent)
+     */
+    public function attemptCompensatingDelete(StorageProvider $provider, string $storageKey): bool
+    {
+        try {
+            $disk = $this->diskFor($provider);
+            if ($disk->exists($storageKey)) {
+                $disk->delete($storageKey);
+            }
+
+            return true;
+        } catch (Throwable $e) {
+            Log::error('file_manager.compensating_delete_failed', [
+                'provider_id' => $provider->id,
+                'storage_key_prefix' => substr($storageKey, 0, 8).'…',
+                'driver' => $provider->driver instanceof StorageProviderDriver
+                    ? $provider->driver->value
+                    : (string) $provider->driver,
+                // No secrets, no full key, no exception message that might leak paths.
+            ]);
+
+            return false;
+        }
+    }
+
+    /**
+     * Read a stream for authorized download.
+     *
+     * @return resource
+     *
+     * @throws RuntimeException when the object is missing or unreadable
+     */
+    public function readStream(StorageProvider $provider, string $storageKey)
+    {
+        $disk = $this->diskFor($provider);
+
+        if (! $disk->exists($storageKey)) {
+            throw new RuntimeException('Stored object not found on the storage provider.');
+        }
+
+        $stream = $disk->readStream($storageKey);
+        if ($stream === false || ! is_resource($stream)) {
+            throw new RuntimeException('Unable to open stored object for reading.');
+        }
+
+        return $stream;
+    }
+
+    /**
+     * Delete the physical object. Used for File Manager-managed deletes only.
+     */
+    public function deleteObject(StorageProvider $provider, string $storageKey): void
+    {
+        try {
+            $disk = $this->diskFor($provider);
+            if ($disk->exists($storageKey)) {
+                $disk->delete($storageKey);
+            }
+        } catch (Throwable $e) {
+            throw new RuntimeException('Failed to delete physical object from storage provider.', 0, $e);
+        }
+    }
+
+    /**
+     * @param  array<string, mixed>  $config
+     */
+    private function buildLocalDisk(array $config): Filesystem
+    {
+        $rootInput = $config['root'] ?? storage_path('app/private');
+        if (! is_string($rootInput)) {
+            throw new RuntimeException('Local storage root path is invalid.');
+        }
+
+        $root = $this->connectionTester->assertSafeLocalRoot($rootInput);
+
+        return Storage::build([
+            'driver' => 'local',
+            'root' => $root,
+            'throw' => true,
+        ]);
+    }
+
+    /**
+     * @param  array<string, mixed>  $config
+     */
+    private function buildS3Disk(array $config): Filesystem
+    {
+        [$diskConfig, $error] = $this->connectionTester->buildS3DiskConfig($config);
+        if ($diskConfig === null) {
+            throw new RuntimeException($error ?? 'S3 storage configuration is not permitted.');
+        }
+        $diskConfig['throw'] = true;
+
+        return Storage::build($diskConfig);
+    }
+}
diff --git a/app/Services/FileManager/FileService.php b/app/Services/FileManager/FileService.php
new file mode 100644
index 0000000..9e231e5
--- /dev/null
+++ b/app/Services/FileManager/FileService.php
@@ -0,0 +1,367 @@
+<?php
+
+namespace App\Services\FileManager;
+
+use App\Enums\FileManager\ManagedBy;
+use App\Enums\FileManager\Ownership;
+use App\Models\FileManager\File;
+use App\Models\FileManager\Folder;
+use App\Models\StorageProvider;
+use App\Services\Storage\StorageProviderManager;
+use Illuminate\Http\UploadedFile;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+use Illuminate\Support\Facades\Log;
+use InvalidArgumentException;
+use RuntimeException;
+use Throwable;
+
+/**
+ * File identity lifecycle: upload, list, retrieve, delete (lifecycle-aware).
+ *
+ * Physical write and DB persistence are coordinated; compensating cleanup on
+ * reverse failure; no silent provider fallback.
+ */
+final class FileService
+{
+    public function __construct(
+        private readonly StorageProviderManager $storageProviders,
+        private readonly FileObjectStorage $objectStorage,
+        private readonly FolderService $folders,
+        private readonly ModuleConfigurationService $modules,
+    ) {}
+
+    /**
+     * @return Collection<int, File>
+     */
+    public function listForContext(?string $schoolId, ?string $folderId = null): Collection
+    {
+        $query = File::query()->orderBy('original_filename');
+
+        if ($schoolId !== null) {
+            $query->forSchool($schoolId);
+        } else {
+            $query->system();
+        }
+
+        if ($folderId === null) {
+            $query->whereNull('folder_id');
+        } else {
+            $query->where('folder_id', $folderId);
+        }
+
+        return $query->get();
+    }
+
+    public function findForContext(string $id, ?string $schoolId): ?File
+    {
+        $file = File::query()->find($id);
+        if ($file === null) {
+            return null;
+        }
+
+        if ($schoolId !== null) {
+            if ($file->isSchoolOwned() && $file->school_id === $schoolId) {
+                return $file;
+            }
+
+            return null;
+        }
+
+        return $file->isSystemOwned() ? $file : null;
+    }
+
+    /**
+     * @param  array{
+     *     folder_id?: string|null,
+     *     storage_provider_id?: string|null,
+     *     managed_by?: string,
+     *     module_code?: string|null,
+     *     ownership?: string
+     * }  $meta
+     */
+    public function upload(UploadedFile $upload, array $meta, ?string $actingSchoolId): File
+    {
+        $ownership = $this->resolveOwnership($meta['ownership'] ?? null, $actingSchoolId);
+        $this->assertCanMutateOwnership($actingSchoolId, $ownership);
+
+        $folder = null;
+        if (! empty($meta['folder_id'])) {
+            $folder = $this->folders->findForContext((string) $meta['folder_id'], $actingSchoolId);
+            if ($folder === null) {
+                throw new InvalidArgumentException('Folder not found in the current ownership context.');
+            }
+            if ($folder->ownership !== $ownership
+                || ($ownership === Ownership::School && $folder->school_id !== $actingSchoolId)) {
+                throw new InvalidArgumentException('File and folder ownership boundaries must match.');
+            }
+        }
+
+        $moduleCode = $meta['module_code'] ?? $folder?->module_code;
+        if ($moduleCode !== null && $moduleCode !== '' && $actingSchoolId !== null) {
+            if (! $this->modules->isEnabled($actingSchoolId, $moduleCode)) {
+                throw new InvalidArgumentException("Module '{$moduleCode}' is disabled for this school.");
+            }
+        }
+
+        $provider = $this->resolveProvider(
+            $meta['storage_provider_id'] ?? null,
+            $folder,
+            $actingSchoolId
+        );
+
+        $managedBy = ManagedBy::tryFrom((string) ($meta['managed_by'] ?? ManagedBy::FileManager->value))
+            ?? ManagedBy::FileManager;
+
+        $extension = $upload->getClientOriginalExtension() ?: pathinfo($upload->getClientOriginalName(), PATHINFO_EXTENSION);
+        $storageKey = $this->objectStorage->generateStorageKey(is_string($extension) ? $extension : null);
+
+        // 1–3: authorize + resolve already done; write physical object.
+        try {
+            $written = $this->objectStorage->write($provider, $storageKey, $upload);
+        } catch (Throwable $e) {
+            // Physical write failed — no File record.
+            throw $e instanceof RuntimeException
+                ? $e
+                : new RuntimeException('Physical write to storage provider failed.', 0, $e);
+        }
+
+        // 4: persist metadata.
+        try {
+            $file = DB::transaction(function () use (
+                $ownership,
+                $actingSchoolId,
+                $folder,
+                $provider,
+                $storageKey,
+                $upload,
+                $written,
+                $managedBy,
+                $moduleCode
+            ) {
+                $file = new File([
+                    'ownership' => $ownership,
+                    'school_id' => $ownership === Ownership::School ? $actingSchoolId : null,
+                    'folder_id' => $folder?->id,
+                    'storage_provider_id' => $provider->id,
+                    'storage_key' => $storageKey,
+                    'original_filename' => $upload->getClientOriginalName() ?: 'upload',
+                    'mime_type' => $written['mime_type'],
+                    'size_bytes' => $written['size_bytes'],
+                    'checksum' => $written['checksum'],
+                    'managed_by' => $managedBy,
+                    'module_code' => $moduleCode ?: null,
+                ]);
+                $file->save();
+
+                return $file;
+            });
+        } catch (Throwable $e) {
+            // 5–6: compensating cleanup.
+            $cleaned = $this->objectStorage->attemptCompensatingDelete($provider, $storageKey);
+            if (! $cleaned) {
+                Log::error('file_manager.upload_orphaned_object', [
+                    'provider_id' => $provider->id,
+                    'storage_key_prefix' => substr($storageKey, 0, 8).'…',
+                    'recovery' => 'Manual inspection of provider objects may be required; File row was not created.',
+                ]);
+                throw new RuntimeException(
+                    'File metadata could not be saved and compensating storage cleanup failed. '
+                    .'The upload is not reported as successful; operators should inspect provider logs.',
+                    0,
+                    $e
+                );
+            }
+
+            throw new RuntimeException(
+                'File metadata could not be saved after a successful storage write. '
+                .'The physical object was removed. Please retry the upload.',
+                0,
+                $e
+            );
+        }
+
+        return $file->fresh();
+    }
+
+    /**
+     * Stream contents for an authorized file.
+     *
+     * @return array{file: File, stream: resource, filename: string, mime: string|null}
+     */
+    public function retrieve(File $file, ?string $actingSchoolId): array
+    {
+        $this->assertFileInContext($file, $actingSchoolId);
+
+        $provider = StorageProvider::query()->find($file->storage_provider_id);
+        if ($provider === null) {
+            throw new RuntimeException('Storage provider for this file no longer exists.');
+        }
+
+        // Ensure provider is still within the same ownership boundary visibility rules.
+        $visible = $this->storageProviders->findForContext($provider->id, $actingSchoolId);
+        if ($visible === null && $actingSchoolId !== null) {
+            // School context reading a school file whose provider is school-owned for same school
+            // is already covered; system providers are not visible to school context for management
+            // but the file's actual provider may still be used for retrieval if ownership matches.
+            // Spec: File and its storage provider must have compatible ownership boundaries.
+            $this->assertProviderOwnershipCompatible($file, $provider);
+        } elseif ($visible === null && $actingSchoolId === null) {
+            $this->assertProviderOwnershipCompatible($file, $provider);
+        }
+
+        $stream = $this->objectStorage->readStream($provider, $file->storage_key);
+
+        return [
+            'file' => $file,
+            'stream' => $stream,
+            'filename' => $file->original_filename,
+            'mime' => $file->mime_type,
+        ];
+    }
+
+    /**
+     * Ordinary File Manager delete. Refuses module-managed files.
+     */
+    public function delete(File $file, ?string $actingSchoolId): void
+    {
+        $this->assertFileInContext($file, $actingSchoolId);
+
+        if ($file->isModuleManaged()) {
+            throw new InvalidArgumentException(
+                'Module-managed files cannot be deleted through ordinary File Manager operations.'
+            );
+        }
+
+        $provider = StorageProvider::query()->find($file->storage_provider_id);
+        $storageKey = $file->storage_key;
+
+        DB::transaction(function () use ($file) {
+            // Detach links first (DB cascade would also handle, but be explicit).
+            $file->attachments()->delete();
+            $file->delete();
+        });
+
+        if ($provider !== null) {
+            try {
+                $this->objectStorage->deleteObject($provider, $storageKey);
+            } catch (Throwable $e) {
+                Log::error('file_manager.delete_physical_failed', [
+                    'file_id' => $file->id,
+                    'provider_id' => $provider->id,
+                    'storage_key_prefix' => substr($storageKey, 0, 8).'…',
+                ]);
+                // File row is gone; physical orphan is an operational concern.
+            }
+        }
+    }
+
+    public function move(File $file, ?string $newFolderId, ?string $actingSchoolId): File
+    {
+        $this->assertFileInContext($file, $actingSchoolId);
+
+        if ($newFolderId === null) {
+            $file->folder_id = null;
+            $file->save();
+
+            return $file->fresh();
+        }
+
+        $folder = $this->folders->findForContext($newFolderId, $actingSchoolId);
+        if ($folder === null) {
+            throw new InvalidArgumentException('Target folder not found in the current ownership context.');
+        }
+
+        if ($folder->ownership !== $file->ownership
+            || ($file->isSchoolOwned() && $folder->school_id !== $file->school_id)) {
+            throw new InvalidArgumentException('File and folder ownership boundaries must match.');
+        }
+
+        $file->folder_id = $folder->id;
+        $file->save();
+
+        return $file->fresh();
+    }
+
+    private function resolveProvider(
+        ?string $providerId,
+        ?Folder $folder,
+        ?string $actingSchoolId
+    ): StorageProvider {
+        $id = $providerId ?? $folder?->default_storage_provider_id;
+        if ($id === null) {
+            throw new InvalidArgumentException(
+                'A storage provider must be specified (or a folder default provider must be set).'
+            );
+        }
+
+        $provider = $this->storageProviders->findForContext((string) $id, $actingSchoolId);
+        if ($provider === null) {
+            throw new InvalidArgumentException('Storage provider not found in the current ownership context.');
+        }
+        if (! $provider->enabled) {
+            throw new InvalidArgumentException('Storage provider is disabled.');
+        }
+
+        return $provider;
+    }
+
+    private function resolveOwnership(?string $requested, ?string $actingSchoolId): Ownership
+    {
+        if ($requested !== null && $requested !== '') {
+            $ownership = Ownership::from($requested);
+            if ($ownership === Ownership::System && $actingSchoolId !== null) {
+                throw new InvalidArgumentException('Cannot create system-owned files from a school context.');
+            }
+            if ($ownership === Ownership::School && $actingSchoolId === null) {
+                throw new InvalidArgumentException('Cannot create school-owned files without a school context.');
+            }
+
+            return $ownership;
+        }
+
+        return $actingSchoolId !== null ? Ownership::School : Ownership::System;
+    }
+
+    private function assertCanMutateOwnership(?string $actingSchoolId, Ownership $ownership): void
+    {
+        if ($ownership === Ownership::System && $actingSchoolId !== null) {
+            throw new InvalidArgumentException('System-owned files cannot be managed from a school context.');
+        }
+        if ($ownership === Ownership::School && $actingSchoolId === null) {
+            throw new InvalidArgumentException('School-owned files cannot be managed outside their school context.');
+        }
+    }
+
+    private function assertFileInContext(File $file, ?string $actingSchoolId): void
+    {
+        if ($actingSchoolId !== null) {
+            if (! $file->isSchoolOwned() || $file->school_id !== $actingSchoolId) {
+                throw new InvalidArgumentException('File is not accessible in the current school context.');
+            }
+
+            return;
+        }
+
+        if (! $file->isSystemOwned()) {
+            throw new InvalidArgumentException('File is not accessible in the platform context.');
+        }
+    }
+
+    private function assertProviderOwnershipCompatible(File $file, StorageProvider $provider): void
+    {
+        if ($file->isSystemOwned() && ! $provider->isSystemOwned()) {
+            throw new InvalidArgumentException('File and storage provider ownership boundaries are incompatible.');
+        }
+        if ($file->isSchoolOwned()) {
+            if ($provider->isSchoolOwned() && $provider->school_id !== $file->school_id) {
+                throw new InvalidArgumentException('File and storage provider belong to different schools.');
+            }
+            // School file may use a system provider only when that is an intentional design;
+            // Phase 1 visibility hides system providers from school management context, but
+            // historical/system default providers may still hold objects. Require same school
+            // for school-owned providers; system providers are allowed for school files only
+            // when explicitly present as the file's actual provider (already stored).
+        }
+    }
+}
diff --git a/app/Services/FileManager/FolderService.php b/app/Services/FileManager/FolderService.php
new file mode 100644
index 0000000..e5d0ab8
--- /dev/null
+++ b/app/Services/FileManager/FolderService.php
@@ -0,0 +1,307 @@
+<?php
+
+namespace App\Services\FileManager;
+
+use App\Enums\FileManager\Ownership;
+use App\Models\FileManager\Folder;
+use App\Models\StorageProvider;
+use App\Services\Storage\StorageProviderManager;
+use App\Support\FileManager\ModuleDefinitionRegistry;
+use Illuminate\Support\Collection;
+use Illuminate\Support\Facades\DB;
+use InvalidArgumentException;
+
+/**
+ * Folder hierarchy operations with ownership, cycle, and capability enforcement.
+ */
+final class FolderService
+{
+    public function __construct(
+        private readonly StorageProviderManager $storageProviders,
+        private readonly ModuleConfigurationService $modules,
+    ) {}
+
+    /**
+     * @return Collection<int, Folder>
+     */
+    public function listForContext(?string $schoolId, ?string $parentId = null): Collection
+    {
+        $query = Folder::query()->orderBy('name');
+
+        if ($schoolId !== null) {
+            $query->forSchool($schoolId);
+        } else {
+            $query->system();
+        }
+
+        if ($parentId === null) {
+            $query->roots();
+        } else {
+            $query->where('parent_id', $parentId);
+        }
+
+        return $query->get();
+    }
+
+    public function findForContext(string $id, ?string $schoolId): ?Folder
+    {
+        $folder = Folder::query()->find($id);
+        if ($folder === null) {
+            return null;
+        }
+
+        if ($schoolId !== null) {
+            if ($folder->isSchoolOwned() && $folder->school_id === $schoolId) {
+                return $folder;
+            }
+
+            return null;
+        }
+
+        return $folder->isSystemOwned() ? $folder : null;
+    }
+
+    /**
+     * @param  array{
+     *     name: string,
+     *     parent_id?: string|null,
+     *     module_code?: string|null,
+     *     default_storage_provider_id?: string|null,
+     *     capabilities?: list<string>|null,
+     *     ownership?: string
+     * }  $data
+     */
+    public function create(array $data, ?string $actingSchoolId): Folder
+    {
+        $ownership = $this->resolveOwnership($data['ownership'] ?? null, $actingSchoolId);
+        $this->assertCanMutateOwnership($actingSchoolId, $ownership);
+
+        $parent = null;
+        if (! empty($data['parent_id'])) {
+            $parent = $this->findForContext((string) $data['parent_id'], $actingSchoolId);
+            if ($parent === null) {
+                throw new InvalidArgumentException('Parent folder not found in the current ownership context.');
+            }
+            $this->assertSameOwnershipBoundary($ownership, $actingSchoolId, $parent);
+        }
+
+        $moduleCode = $data['module_code'] ?? $parent?->module_code;
+        if ($moduleCode !== null && $moduleCode !== '') {
+            ModuleDefinitionRegistry::require($moduleCode);
+            if ($actingSchoolId !== null && ! $this->modules->isEnabled($actingSchoolId, $moduleCode)) {
+                throw new InvalidArgumentException("Module '{$moduleCode}' is disabled for this school.");
+            }
+        } else {
+            $moduleCode = null;
+        }
+
+        $capabilities = $this->resolveCapabilities(
+            $data['capabilities'] ?? null,
+            $moduleCode,
+            $parent
+        );
+
+        $providerId = $data['default_storage_provider_id'] ?? $parent?->default_storage_provider_id;
+        if ($providerId !== null) {
+            $this->assertProviderInContext((string) $providerId, $actingSchoolId);
+        }
+
+        $folder = new Folder([
+            'ownership' => $ownership,
+            'school_id' => $ownership === Ownership::School ? $actingSchoolId : null,
+            'parent_id' => $parent?->id,
+            'name' => trim((string) $data['name']),
+            'module_code' => $moduleCode,
+            'default_storage_provider_id' => $providerId,
+            'capabilities' => $capabilities,
+        ]);
+        $folder->save();
+
+        return $folder->fresh();
+    }
+
+    /**
+     * @param  array{name?: string, default_storage_provider_id?: string|null, capabilities?: list<string>|null}  $data
+     */
+    public function update(Folder $folder, array $data, ?string $actingSchoolId): Folder
+    {
+        $this->assertFolderInContext($folder, $actingSchoolId);
+
+        if (array_key_exists('name', $data)) {
+            $folder->name = trim((string) $data['name']);
+        }
+
+        if (array_key_exists('default_storage_provider_id', $data)) {
+            $providerId = $data['default_storage_provider_id'];
+            if ($providerId !== null) {
+                $this->assertProviderInContext((string) $providerId, $actingSchoolId);
+            }
+            // Changing default provider affects future uploads only; existing files keep their provider.
+            $folder->default_storage_provider_id = $providerId;
+        }
+
+        if (array_key_exists('capabilities', $data) && is_array($data['capabilities'])) {
+            $folder->capabilities = $this->resolveCapabilities(
+                $data['capabilities'],
+                $folder->module_code,
+                $folder->parent
+            );
+        }
+
+        $folder->save();
+
+        return $folder->fresh();
+    }
+
+    public function move(Folder $folder, ?string $newParentId, ?string $actingSchoolId): Folder
+    {
+        $this->assertFolderInContext($folder, $actingSchoolId);
+
+        if ($newParentId === $folder->id) {
+            throw new InvalidArgumentException('A folder cannot be its own parent.');
+        }
+
+        $newParent = null;
+        if ($newParentId !== null) {
+            $newParent = $this->findForContext($newParentId, $actingSchoolId);
+            if ($newParent === null) {
+                throw new InvalidArgumentException('Target parent folder not found in the current ownership context.');
+            }
+            $this->assertSameOwnershipBoundary($folder->ownership, $folder->school_id, $newParent);
+
+            if ($this->wouldCreateCycle($folder, $newParent)) {
+                throw new InvalidArgumentException('Move would create a cycle in the folder hierarchy.');
+            }
+        }
+
+        $folder->parent_id = $newParent?->id;
+        $folder->save();
+
+        return $folder->fresh();
+    }
+
+    public function delete(Folder $folder, ?string $actingSchoolId): void
+    {
+        $this->assertFolderInContext($folder, $actingSchoolId);
+
+        if (! $folder->isEmpty()) {
+            throw new InvalidArgumentException('Cannot delete a folder that still contains child folders or files.');
+        }
+
+        $folder->delete();
+    }
+
+    public function wouldCreateCycle(Folder $folder, Folder $prospectiveParent): bool
+    {
+        $current = $prospectiveParent;
+        $guard = 0;
+        while ($current !== null) {
+            if ($current->id === $folder->id) {
+                return true;
+            }
+            if ($current->parent_id === null) {
+                break;
+            }
+            $current = Folder::query()->find($current->parent_id);
+            if (++$guard > 10000) {
+                // Pathological depth protection for the cycle walk only; not a product depth limit.
+                return true;
+            }
+        }
+
+        return false;
+    }
+
+    private function resolveOwnership(?string $requested, ?string $actingSchoolId): Ownership
+    {
+        if ($requested !== null && $requested !== '') {
+            $ownership = Ownership::from($requested);
+            if ($ownership === Ownership::System && $actingSchoolId !== null) {
+                throw new InvalidArgumentException('Cannot create system-owned folders from a school context.');
+            }
+            if ($ownership === Ownership::School && $actingSchoolId === null) {
+                throw new InvalidArgumentException('Cannot create school-owned folders without a school context.');
+            }
+
+            return $ownership;
+        }
+
+        return $actingSchoolId !== null ? Ownership::School : Ownership::System;
+    }
+
+    private function assertCanMutateOwnership(?string $actingSchoolId, Ownership $ownership): void
+    {
+        if ($ownership === Ownership::System && $actingSchoolId !== null) {
+            throw new InvalidArgumentException('System-owned folders cannot be managed from a school context.');
+        }
+        if ($ownership === Ownership::School && $actingSchoolId === null) {
+            throw new InvalidArgumentException('School-owned folders cannot be managed outside their school context.');
+        }
+    }
+
+    private function assertFolderInContext(Folder $folder, ?string $actingSchoolId): void
+    {
+        if ($actingSchoolId !== null) {
+            if (! $folder->isSchoolOwned() || $folder->school_id !== $actingSchoolId) {
+                throw new InvalidArgumentException('Folder is not accessible in the current school context.');
+            }
+
+            return;
+        }
+
+        if (! $folder->isSystemOwned()) {
+            throw new InvalidArgumentException('Folder is not accessible in the platform context.');
+        }
+    }
+
+    private function assertSameOwnershipBoundary(Ownership $ownership, ?string $schoolId, Folder $other): void
+    {
+        if ($other->ownership !== $ownership) {
+            throw new InvalidArgumentException('Parent and child folders must share the same ownership boundary.');
+        }
+        if ($ownership === Ownership::School && $other->school_id !== $schoolId) {
+            throw new InvalidArgumentException('Parent and child folders must belong to the same school.');
+        }
+    }
+
+    private function assertProviderInContext(string $providerId, ?string $actingSchoolId): void
+    {
+        $provider = $this->storageProviders->findForContext($providerId, $actingSchoolId);
+        if ($provider === null) {
+            throw new InvalidArgumentException('Storage provider not found in the current ownership context.');
+        }
+        if (! $provider->enabled) {
+            throw new InvalidArgumentException('Storage provider is disabled.');
+        }
+    }
+
+    /**
+     * @param  list<string>|null  $requested
+     * @return list<string>
+     */
+    private function resolveCapabilities(?array $requested, ?string $moduleCode, ?Folder $parent): array
+    {
+        if ($moduleCode === null || $moduleCode === '') {
+            // No module: allow full set if explicitly requested, else inherit parent or empty.
+            if ($requested !== null) {
+                return array_values(array_unique(array_filter($requested, 'is_string')));
+            }
+
+            return $parent?->capabilityList() ?? [];
+        }
+
+        $definition = ModuleDefinitionRegistry::require($moduleCode);
+
+        if ($requested === null) {
+            $requested = $parent?->capabilityList() ?? $definition->maxCapabilityValues();
+        }
+
+        if (! $definition->acceptsCapabilities($requested)) {
+            throw new InvalidArgumentException(
+                "Folder capabilities exceed the maximum allowed for module '{$moduleCode}'."
+            );
+        }
+
+        return $definition->clampCapabilities($requested);
+    }
+}
diff --git a/app/Services/FileManager/ModuleConfigurationService.php b/app/Services/FileManager/ModuleConfigurationService.php
new file mode 100644
index 0000000..7871a53
--- /dev/null
+++ b/app/Services/FileManager/ModuleConfigurationService.php
@@ -0,0 +1,97 @@
+<?php
+
+namespace App\Services\FileManager;
+
+use App\Models\FileManager\SchoolModuleConfiguration;
+use App\Support\FileManager\ModuleDefinition;
+use App\Support\FileManager\ModuleDefinitionRegistry;
+use Illuminate\Support\Collection;
+use InvalidArgumentException;
+
+/**
+ * Per-school module enablement. Lazy provisioning; never elevates registry ceilings.
+ */
+final class ModuleConfigurationService
+{
+    /**
+     * @return Collection<int, array{definition: ModuleDefinition, configuration: SchoolModuleConfiguration|null}>
+     */
+    public function listForSchool(string $schoolId): Collection
+    {
+        $configs = SchoolModuleConfiguration::query()
+            ->where('school_id', $schoolId)
+            ->get()
+            ->keyBy('module_code');
+
+        return collect(ModuleDefinitionRegistry::all())->map(
+            static function (ModuleDefinition $definition) use ($configs) {
+                return [
+                    'definition' => $definition,
+                    'configuration' => $configs->get($definition->code),
+                ];
+            }
+        )->values();
+    }
+
+    public function isEnabled(string $schoolId, string $moduleCode): bool
+    {
+        $definition = ModuleDefinitionRegistry::get($moduleCode);
+        if ($definition === null || $definition->retired) {
+            return false;
+        }
+
+        $config = SchoolModuleConfiguration::query()
+            ->where('school_id', $schoolId)
+            ->where('module_code', $moduleCode)
+            ->first();
+
+        // Lazy: no row means enabled by default for active modules.
+        if ($config === null) {
+            return true;
+        }
+
+        return (bool) $config->enabled;
+    }
+
+    /**
+     * @param  array{enabled?: bool, settings?: array<string, mixed>|null}  $data
+     */
+    public function configure(string $schoolId, string $moduleCode, array $data): SchoolModuleConfiguration
+    {
+        $definition = ModuleDefinitionRegistry::require($moduleCode);
+        if ($definition->retired) {
+            throw new InvalidArgumentException("Module '{$moduleCode}' is retired and cannot be configured.");
+        }
+
+        $config = SchoolModuleConfiguration::query()->firstOrNew([
+            'school_id' => $schoolId,
+            'module_code' => $moduleCode,
+        ]);
+
+        if ($config->exists === false) {
+            $config->enabled = true;
+            $config->settings = null;
+        }
+
+        if (array_key_exists('enabled', $data)) {
+            $config->enabled = (bool) $data['enabled'];
+        }
+
+        if (array_key_exists('settings', $data)) {
+            // Re-enable must not silently wipe existing settings unless explicitly provided.
+            $config->settings = $data['settings'];
+        }
+
+        $config->save();
+
+        return $config->fresh();
+    }
+
+    public function find(string $schoolId, string $moduleCode): ?SchoolModuleConfiguration
+    {
+        return SchoolModuleConfiguration::query()
+            ->where('school_id', $schoolId)
+            ->where('module_code', $moduleCode)
+            ->first();
+    }
+}
