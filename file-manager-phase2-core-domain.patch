--- /dev/null
+++ b/app/Support/FileManager/ModuleDefinition.php
@@ -0,0 +1,76 @@
+<?php
+
+namespace App\Support\FileManager;
+
+use App\Enums\FileManager\Capability;
+
+/**
+ * Immutable code-defined module registration for File Manager.
+ *
+ * The database cannot invent modules; school configuration cannot elevate
+ * capabilities beyond the maximum declared here.
+ *
+ * @phpstan-type CapabilityList list<value-of<Capability>>
+ */
+final class ModuleDefinition
+{
+    /**
+     * @param  list<string>  $maxCapabilities  Capability::value strings
+     */
+    public function __construct(
+        public readonly string $code,
+        public readonly string $label,
+        public readonly string $description = '',
+        public readonly array $maxCapabilities = [],
+        public readonly bool $retired = false,
+    ) {
+        foreach ($this->maxCapabilities as $cap) {
+            if (! is_string($cap) || Capability::tryFrom($cap) === null) {
+                throw new \InvalidArgumentException("Unknown capability '{$cap}' for module '{$this->code}'.");
+            }
+        }
+    }
+
+    /**
+     * @return list<string>
+     */
+    public function maxCapabilityValues(): array
+    {
+        return array_values(array_unique($this->maxCapabilities));
+    }
+
+    public function allows(string $capability): bool
+    {
+        return in_array($capability, $this->maxCapabilityValues(), true);
+    }
+
+    /**
+     * Cap a proposed capability set to this module's maximum.
+     *
+     * @param  list<string>  $requested
+     * @return list<string>
+     */
+    public function clampCapabilities(array $requested): array
+    {
+        $max = $this->maxCapabilityValues();
+
+        return array_values(array_intersect($requested, $max));
+    }
+
+    /**
+     * True when requested is a subset of the module maximum.
+     *
+     * @param  list<string>  $requested
+     */
+    public function acceptsCapabilities(array $requested): bool
+    {
+        $max = $this->maxCapabilityValues();
+        foreach ($requested as $cap) {
+            if (! in_array($cap, $max, true)) {
+                return false;
+            }
+        }
+
+        return true;
+    }
+}
diff --git a/app/Support/FileManager/ModuleDefinitionRegistry.php b/app/Support/FileManager/ModuleDefinitionRegistry.php
new file mode 100644
index 0000000..ce3a6f0
--- /dev/null
+++ b/app/Support/FileManager/ModuleDefinitionRegistry.php
@@ -0,0 +1,144 @@
+<?php
+
+namespace App\Support\FileManager;
+
+use App\Enums\FileManager\Capability;
+use InvalidArgumentException;
+
+/**
+ * Authoritative code-defined registry of File Manager modules.
+ *
+ * Follows the same developer-owned pattern as PermissionCatalogue / SettingsRegistry:
+ * existence and capability ceilings live in code; per-school enablement lives in DB.
+ *
+ * Retiring a definition does not delete stored folders, files, attachments, or
+ * school configuration rows.
+ */
+final class ModuleDefinitionRegistry
+{
+    /** @var array<string, ModuleDefinition>|null */
+    private static ?array $definitions = null;
+
+    /**
+     * @return array<string, ModuleDefinition>
+     */
+    public static function all(): array
+    {
+        return self::definitions();
+    }
+
+    public static function get(string $code): ?ModuleDefinition
+    {
+        return self::definitions()[$code] ?? null;
+    }
+
+    public static function require(string $code): ModuleDefinition
+    {
+        $definition = self::get($code);
+        if ($definition === null) {
+            throw new InvalidArgumentException("Unknown File Manager module code '{$code}'.");
+        }
+
+        return $definition;
+    }
+
+    public static function has(string $code): bool
+    {
+        return isset(self::definitions()[$code]);
+    }
+
+    /**
+     * Active (non-retired) definitions only.
+     *
+     * @return array<string, ModuleDefinition>
+     */
+    public static function active(): array
+    {
+        return array_filter(
+            self::definitions(),
+            static fn (ModuleDefinition $d) => ! $d->retired
+        );
+    }
+
+    /**
+     * Reset cached definitions (tests only).
+     */
+    public static function flush(): void
+    {
+        self::$definitions = null;
+    }
+
+    /**
+     * @return array<string, ModuleDefinition>
+     */
+    private static function definitions(): array
+    {
+        if (self::$definitions !== null) {
+            return self::$definitions;
+        }
+
+        $allCapabilities = Capability::values();
+
+        $list = [
+            new ModuleDefinition(
+                code: 'general',
+                label: 'General',
+                description: 'Default school file library for general documents.',
+                maxCapabilities: $allCapabilities,
+            ),
+            new ModuleDefinition(
+                code: 'academic',
+                label: 'Academic',
+                description: 'Academic materials, syllabi, and lesson resources.',
+                maxCapabilities: $allCapabilities,
+            ),
+            new ModuleDefinition(
+                code: 'student',
+                label: 'Student',
+                description: 'Student-related documents and attachments.',
+                maxCapabilities: [
+                    Capability::Browse->value,
+                    Capability::Upload->value,
+                    Capability::Download->value,
+                    Capability::Attach->value,
+                    Capability::Rename->value,
+                    Capability::Delete->value,
+                ],
+            ),
+            new ModuleDefinition(
+                code: 'employee',
+                label: 'Employee',
+                description: 'Employee HR and administrative documents.',
+                maxCapabilities: [
+                    Capability::Browse->value,
+                    Capability::Upload->value,
+                    Capability::Download->value,
+                    Capability::Attach->value,
+                    Capability::Rename->value,
+                    Capability::Delete->value,
+                ],
+            ),
+            new ModuleDefinition(
+                code: 'finance',
+                label: 'Finance',
+                description: 'Financial documents and receipts.',
+                maxCapabilities: [
+                    Capability::Browse->value,
+                    Capability::Upload->value,
+                    Capability::Download->value,
+                    Capability::Attach->value,
+                    Capability::Rename->value,
+                    Capability::Move->value,
+                    Capability::Delete->value,
+                ],
+            ),
+        ];
+
+        $map = [];
+        foreach ($list as $definition) {
+            $map[$definition->code] = $definition;
+        }
+
+        return self::$definitions = $map;
+    }
+}
diff --git a/database/factories/FileManager/FolderFactory.php b/database/factories/FileManager/FolderFactory.php
new file mode 100644
index 0000000..dee5462
--- /dev/null
+++ b/database/factories/FileManager/FolderFactory.php
@@ -0,0 +1,38 @@
+<?php
+
+namespace Database\Factories\FileManager;
+
+use App\Enums\FileManager\Ownership;
+use App\Models\FileManager\Folder;
+use Illuminate\Database\Eloquent\Factories\Factory;
+use Illuminate\Support\Str;
+
+/**
+ * @extends Factory<Folder>
+ */
+class FolderFactory extends Factory
+{
+    protected $model = Folder::class;
+
+    public function definition(): array
+    {
